[Unit]
Description=Prefect Server
After=network-online.target
Wants=network-online.target

[Service]
User=almalinux
ExecStart={{ pipeline_venv_dir }}/bin/prefect server start \
    --host {{ controller_ip }} \
    --port {{ prefect_server_port }}
Restart=on-failure
RestartSec=5
Environment=HOME=/home/almalinux

[Install]
WantedBy=multi-user.target